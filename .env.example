# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# .env.local 은 git 에 올라가지 않습니다.
#
# 아래 값을 비워 둬도 사이트는 정상 동작합니다. (샘플 값이 표시됩니다)


# ── 카카오 지도 + 카카오톡 공유 ────────────────────────────────
#
# 1. https://developers.kakao.com 로그인 → 내 애플리케이션 → 애플리케이션 추가하기
# 2. 앱 키 탭 → "JavaScript 키" 복사
# 3. 플랫폼 → Web → 사이트 도메인에 배포 주소와 http://localhost:3000 등록
# 4. 카카오 로그인은 켜지 않아도 됩니다. "카카오톡 공유" 기능만 있으면 동작합니다.
#
# 키가 없으면 지도 대신 안내 문구가 표시되고, 공유는 링크 복사로 대체됩니다.
NEXT_PUBLIC_KAKAO_JS_KEY=


# ── 전화번호 ───────────────────────────────────────────────────
#
# 저장소가 공개라서 실제 번호는 코드에 넣지 않고 여기에 둡니다.
# 반드시 한 줄로, 작은따옴표로 감싸서 적어주세요.
NEXT_PUBLIC_WEDDING_CONTACTS='{"groom":"010-0000-0000","groomFather":"010-0000-0000","groomMother":"010-0000-0000","bride":"010-0000-0000","brideFather":"010-0000-0000","brideMother":"010-0000-0000","venue":"02-000-0000"}'


# ── 계좌번호 ───────────────────────────────────────────────────
#
# groom / bride 각각에 필요한 만큼 넣으면 됩니다. (1개만 넣어도 됩니다)
# label 은 화면에 표시되는 관계 표기입니다. (신랑, 아버지, 어머니 등)
# 카카오페이 송금 링크가 있으면 "kakaopayUrl":"https://..." 를 추가할 수 있습니다.
NEXT_PUBLIC_WEDDING_ACCOUNTS='{"groom":[{"label":"신랑","bank":"국민은행","number":"000000-00-000000","holder":"홍길동"}],"bride":[{"label":"신부","bank":"카카오뱅크","number":"3333-00-0000000","holder":"김영희"}]}'
